# Local configuration and secrets
.env
.env.*
!.env.example

# Installed dependencies and build output
vendor/
node_modules/
dist/
build/
coverage/

# Laravel storage and cache
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/database/database.sqlite

# Runtime and editor files
uploads/
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
.venv-ocr*/

# Personal working notes and generated design / QA reports (keep locally)
/AGENTS.md
/plan_to_enhance.md
/PROJECT_TRACKER.md
/prompt update latest dari aku.md
/design-system/

# Only runtime and supported maintenance tooling belongs in the shared scripts folder.
# Ad-hoc QA, recording, research and machine-specific helpers stay local.
/scripts/*
!/scripts/ocr_cv.py
!/scripts/ocr_requirements.txt
!/scripts/export_schema_snapshot.php
!/scripts/validate_sql_snapshots.php
!/scripts/sync_local_admin.php

# Superseded media and internal asset-generation notes
/frontend/public/media/skills-journey*
/frontend/public/media/ASSET_NOTES.md

# Python bytecode
__pycache__/
*.py[cod]
